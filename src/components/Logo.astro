---
import type { SiteLogo } from "../lib/types";

// Horizontal logo: crest + rule + wordmark (the design system's Logo component).
// A logo uploaded in Site Settings replaces it.
interface Props {
	height?: number;
	tone?: "color" | "reversed";
	logo?: SiteLogo | null;
	alt?: string;
}

const { height = 44, tone = "color", logo, alt = "Lakefront Digital" } = Astro.props;
const wordHeight = Math.round(height * 0.5);
---

{
	logo ? (
		<img src={logo.url} alt={logo.alt || alt} width={logo.width} height={logo.height} class="lfw-sitelogo" style={`height:${height}px`} />
	) : (
		<span class:list={["lf-logo", "lf-logo--horizontal", tone === "reversed" && "lf-logo--reversed"]} style={`gap:${Math.round(height * 0.3)}px`}>
			<img src="/brand/lakefront-crest.png" alt="" width={Math.round((805 / 797) * height)} height={height} style={`height:${height}px`} />
			<span class="lf-logo__rule" aria-hidden="true" style={`height:${Math.round(height * 0.72)}px`} />
			<img class="lf-logo__word" src="/brand/lakefront-wordmark.png" alt={alt} width={Math.round((1049 / 221) * wordHeight)} height={wordHeight} style={`height:${wordHeight}px`} />
		</span>
	)
}
