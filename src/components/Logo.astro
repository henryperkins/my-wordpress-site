---
import type { SiteLogo } from "../lib/types";

// Horizontal logo: crest + rule + wordmark (the design system's Logo component), vector files in public/brand.
// "reversed" uses the navy-ground artwork. A logo uploaded in Site Settings replaces it.
// Forced colours (Windows high contrast) repaint the page in the system palette but leave images alone, so each image
// switches to the artwork drawn for that palette's background: reversed on a dark one, navy ink on a light one.
interface Props {
	height?: number;
	tone?: "color" | "reversed";
	logo?: SiteLogo | null;
	alt?: string;
	loading?: "eager" | "lazy";
}

const { height = 44, tone = "color", logo, alt = "Lakefront Digital", loading = "eager" } = Astro.props;
const wordHeight = Math.round(height * 0.5);
const suffix = tone === "reversed" ? "-reversed" : "";
const forced =
	tone === "reversed"
		? { media: "(forced-colors: active) and (prefers-color-scheme: light)", suffix: "" }
		: { media: "(forced-colors: active) and (prefers-color-scheme: dark)", suffix: "-reversed" };
---

{
	logo ? (
		<img src={logo.url} alt={logo.alt || alt} width={logo.width} height={logo.height} class="lfw-sitelogo" style={`height:${height}px`} loading={loading} />
	) : (
		<span class:list={["lf-logo", "lf-logo--horizontal", tone === "reversed" && "lf-logo--reversed"]} style={`gap:${Math.round(height * 0.3)}px`}>
			<picture>
				<source media={forced.media} srcset={`/brand/lakefront-crest${forced.suffix}.svg`} />
				<img src={`/brand/lakefront-crest${suffix}.svg`} alt="" width={Math.round((805 / 797) * height)} height={height} style={`height:${height}px`} loading={loading} />
			</picture>
			<span class="lf-logo__rule" aria-hidden="true" style={`height:${Math.round(height * 0.72)}px`} />
			<picture>
				<source media={forced.media} srcset={`/brand/lakefront-wordmark${forced.suffix}.svg`} />
				<img class="lf-logo__word" src={`/brand/lakefront-wordmark${suffix}.svg`} alt={alt} width={Math.round((1049 / 221) * wordHeight)} height={wordHeight} style={`height:${wordHeight}px`} loading={loading} />
			</picture>
		</span>
	)
}
