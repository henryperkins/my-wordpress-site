---
import { Image } from "emdash/ui";
import { photoFor, sizesFor, srcsetFor, type PhotoLayout } from "../lib/photos";
import type { EmDashImage } from "../lib/types";

// An uploaded image wins; otherwise the block's bundled photo (public/images) is used, resized at the edge.
interface Props {
	image?: EmDashImage | null;
	photo?: string | null;
	fallback?: string;
	priority?: boolean;
	class?: string;
	/** Layout slot and cover crop (lib/photos); defaults to the consultation panel. */
	layout?: PhotoLayout;
	/** Explicit width-only sizes for a custom or content-driven crop. */
	sizes?: string;
}

const { image, photo, fallback = "shore", priority = false, class: className, layout = "product", sizes } = Astro.props;
const bundled = photoFor(photo, fallback);
const responsiveSizes = sizes ?? sizesFor(layout, image ?? bundled);
---

{
	image ? (
		<Image image={image} class={className} priority={priority} sizes={responsiveSizes} />
	) : (
		<img
			src={bundled.src}
			srcset={srcsetFor(bundled)}
			sizes={responsiveSizes}
			alt={bundled.alt}
			width={bundled.width}
			height={bundled.height}
			class={className}
			loading={priority ? "eager" : "lazy"}
			fetchpriority={priority ? "high" : undefined}
			decoding="async"
			style={bundled.position ? `object-position:${bundled.position}` : undefined}
		/>
	)
}
