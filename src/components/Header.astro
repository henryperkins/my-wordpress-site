---
import AISearchSnippet from "@emdash-cms/cloudflare/plugins/ai-search/astro";
import Button from "./Button.astro";
import Icon from "./Icon.astro";
import Logo from "./Logo.astro";
import { isCurrent, linkAttrs } from "../lib/menus";
import type { MenuItem, SiteLogo } from "../lib/types";

// Primary nav comes from the "primary" menu; the button is the first item of "header_cta".
// A menu item with children (Services › All services, SEO) opens a small panel; scripts/header.ts toggles it.
// Same markup as the design system's SiteHeader (components/site/SiteHeader.jsx).
// The search icon links to /search; with JavaScript it opens the AI search modal instead (also Cmd/Ctrl+K).
// On phones the page owns the primary action; the header keeps search and ordinary navigation links.
// The modal sits after <header>: the header's backdrop-filter would confine its fixed overlay to the bar.
interface Props {
	siteTitle: string;
	logo?: SiteLogo | null;
	items: MenuItem[];
	cta?: MenuItem;
	admin?: boolean;
}

const { siteTitle, logo, items, cta, admin = false } = Astro.props;
const current = (url: string) => (isCurrent(url, Astro.url) ? "page" : undefined);
const kids = (item: MenuItem): MenuItem[] => (item.children ?? []) as MenuItem[];
const groupCurrent = (item: MenuItem) => isCurrent(item.url, Astro.url) || kids(item).some((child) => isCurrent(child.url, Astro.url));
const pathOf = (url: string) => {
	try {
		return new URL(url, Astro.url).pathname.replace(/\/+$/, "") || "/";
	} catch {
		return url;
	}
};
// On mobile the parent is a link, so children that repeat it ("All services") are left out.
const subItems = (item: MenuItem) => kids(item).filter((child) => pathOf(child.url) !== pathOf(item.url));
const ctaAttrs = cta ? linkAttrs(cta) : undefined;
// On the destination page, preserve tracking/validation query parameters and entered form data.
// An explicit query in the CMS destination still requests that different navigation.
if (cta && ctaAttrs && isCurrent(cta.url, Astro.url)) {
	const destination = new URL(cta.url, Astro.url);
	if (destination.hash && !destination.search) ctaAttrs.href = destination.hash;
}
---

<header class:list={["lfw-header", items.length === 0 && "lfw-header--nonav"]} data-header>
	<div class="lfw-container lfw-header__in">
		<a href="/" class="lfw-logo-link" aria-label={`${siteTitle}, home`}>
			<Logo height={40} logo={logo} alt={siteTitle} />
		</a>
		{
			items.length > 0 && (
				<nav class="lfw-nav" aria-label="Primary">
					{items.map((item, i) =>
						kids(item).length > 0 ? (
							<div class="lfw-navgroup" data-navgroup>
								<button type="button" class:list={["lfw-nav__btn", groupCurrent(item) && "is-current"]} aria-expanded="false" aria-controls={`lfw-subnav-${i}`}>
									{item.label}
									<Icon name="chevron-down" size={16} />
								</button>
								<div class="lfw-subnav" id={`lfw-subnav-${i}`} hidden>
									{kids(item).map((child) => (
										<a {...linkAttrs(child)} aria-current={current(child.url)}>
											{child.label}
										</a>
									))}
								</div>
							</div>
						) : (
							<a {...linkAttrs(item)} aria-current={current(item.url)}>
								{item.label}
							</a>
						),
					)}
				</nav>
			)
		}
		<div class="lfw-tools">
			<a class="lf-iconbtn" href="/search" aria-label="Search" aria-current={current("/search")} data-ai-search-open><Icon name="search" /></a>
			{admin && <a class="lf-iconbtn" href="/_emdash/admin" aria-label="Admin"><Icon name="settings" /></a>}
		</div>
		{
			cta && (
				<Button {...ctaAttrs} class="lfw-header__cta" iconRight="arrow-right">
					{cta.label}
				</Button>
			)
		}
		<button type="button" class="lf-iconbtn lf-iconbtn--outline lfw-menu" aria-expanded="false" aria-controls="lfw-mobile-nav" aria-label="Open menu" data-menu-toggle>
			<Icon name="menu" class="lfw-menu__open" />
			<Icon name="x" class="lfw-menu__close" />
		</button>
	</div>
	<nav class="lfw-mobile" id="lfw-mobile-nav" aria-label="Menu" hidden data-mobile-nav>
		{
			items.map((item) => (
				<>
					<a {...linkAttrs(item)} aria-current={current(item.url)}>
						{item.label}
					</a>
					{subItems(item).length > 0 && (
						<div class="lfw-mobile__sub">
							{subItems(item).map((child) => (
								<a {...linkAttrs(child)} aria-current={current(child.url)}>
									{child.label}
								</a>
							))}
						</div>
					)}
				</>
			))
		}
		{
			cta && (
				<a {...ctaAttrs} aria-current={current(cta.url)}>
					{cta.label}
				</a>
			)
		}
	</nav>
</header>

<AISearchSnippet id="lfw-ai-search" placeholder="Search services, hosting, SEO…" theme="light" seeMore="/search?q=" />

<script>
	import "../scripts/ai-search-compat";
	import "../scripts/header";
</script>
