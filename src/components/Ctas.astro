---
import Button from "./Button.astro";
import type { Cta } from "../lib/text";

interface Props {
	primary?: Cta;
	secondary?: Cta;
	size?: "md" | "lg";
	secondaryVariant?: "outline" | "ghost" | "secondary";
	/** One short line under the buttons that answers the question before the click, e.g. "Your first consultation is free." */
	note?: string | null;
}

const { primary, secondary, size = "md", secondaryVariant = "outline", note } = Astro.props;
---

{
	(primary || secondary) && (
		<div class="lfw-hero__ctas">
			{primary && (
				<Button href={primary.url} size={size} iconRight="arrow-right">
					{primary.label}
				</Button>
			)}
			{secondary && (
				<Button href={secondary.url} size={size} variant={secondaryVariant}>
					{secondary.label}
				</Button>
			)}
			{note && <p class="lfw-ctas__note">{note}</p>}
		</div>
	)
}
