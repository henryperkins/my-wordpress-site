---
import Icon from "./Icon.astro";
import Logo from "./Logo.astro";
import { linkAttrs } from "../lib/menus";
import type { MenuItem, SiteLogo } from "../lib/types";

// Light footer, on every page. The top row holds the logo and the Site Settings tagline beside the primary menu's
// top-level links; the base row holds the copyright and the footer_legal links, then the footer_contact links and
// "Back to top" (#top, the page root in Base.astro).
// A tagline with a "·" splits at the first one into the place, a dot drawn in CSS and the rest, which wraps inside its
// own box, so the place never ends a line on its own ("Chicago · Serving small businesses across the US").
interface Props {
	siteTitle: string;
	logo?: SiteLogo | null;
	tagline?: string;
	items: MenuItem[];
	legal: MenuItem[];
	contact: MenuItem[];
}

const { siteTitle, logo, tagline = "", items, legal, contact } = Astro.props;
const year = new Date().getFullYear();
const line = tagline.trim();
const dot = line.indexOf("·");
const place = dot > 0 ? line.slice(0, dot).trim() : "";
const rest = dot > 0 ? line.slice(dot + 1).trim() : "";
---

<footer class="lfw-footer">
	<div class="lfw-container lfw-footer__in">
		<div class="lfw-footer__top">
			<div class="lfw-footer__brand">
				<a href="/" class="lfw-logo-link" aria-label={`${siteTitle}, home`}>
					<Logo height={44} logo={logo} alt={siteTitle} loading="lazy" />
				</a>
				{
					line && (
						<p class="lfw-footer__place">
							{place && rest ? (
								<>
									<span class="lfw-footer__city">{place}</span>
									<span class="lfw-dot" aria-hidden="true" />
									<span class="lfw-footer__reach">{rest}</span>
								</>
							) : (
								line
							)}
						</p>
					)
				}
			</div>
			{
				items.length > 0 && (
					<nav class="lfw-footer__nav" aria-label="Footer">
						<ul role="list">
							{items.map((item) => (
								<li>
									<a {...linkAttrs(item)}>{item.label}</a>
								</li>
							))}
						</ul>
					</nav>
				)
			}
		</div>
		<div class="lfw-footer__base">
			<div class="lfw-footer__group">
				<p class="lfw-footer__copy">© {year} {siteTitle}</p>
				{
					legal.map((item) => (
						<a class="lfw-footer__link" {...linkAttrs(item)}>
							{item.label}
						</a>
					))
				}
			</div>
			<div class="lfw-footer__group">
				{
					contact.map((item) => (
						<a class="lfw-footer__link" {...linkAttrs(item)}>
							{item.label}
						</a>
					))
				}
				<a class="lfw-footer__totop" href="#top">Back to top<Icon name="arrow-up" size={16} /></a>
			</div>
		</div>
	</div>
</footer>
