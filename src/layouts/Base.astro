---
import { getSiteSettingsWithCacheHint } from "emdash";
import { EmDashBodyEnd, EmDashBodyStart, EmDashHead } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import { Font } from "astro:assets";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { itemsOf, loadMenus, menuHeading } from "../lib/menus";
import type { SiteLogo } from "../lib/types";
import "../styles/tokens.css";
import "../styles/components.css";
import "../styles/site.css";
import "../styles/theme.css";

interface Props {
	title: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	robots?: string | null;
	type?: "website" | "article";
	/** Content reference for plugin page contributions on content pages */
	content?: { collection: string; id: string; slug?: string | null };
}

const { title, pageTitle, description, image, canonical, robots, type = "website", content } = Astro.props;

const [settingsResult, { menus, hints }] = await Promise.all([getSiteSettingsWithCacheHint(), loadMenus()]);
if (Astro.cache?.enabled) {
	Astro.cache.set(settingsResult.cacheHint);
	for (const hint of hints) Astro.cache.set(hint);
}

const settings = settingsResult.data;
const siteTitle = settings?.title || "Lakefront Digital";
const tagline = settings?.tagline || "";
const logo: SiteLogo | null = settings?.logo?.url ? { url: settings.logo.url, alt: settings.logo.alt } : null;

// One title format everywhere, "Services — Lakefront Digital"; the home page is just the site name.
const bare = [` | ${siteTitle}`, ` — ${siteTitle}`, ` - ${siteTitle}`].reduce(
	(text, suffix) => (text.endsWith(suffix) ? text.slice(0, -suffix.length) : text),
	title.trim(),
);
const fullTitle = !bare || bare === siteTitle ? siteTitle : `${bare} — ${siteTitle}`;

// SEO data is passed here and rendered by EmDashHead, along with plugin contributions.
const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: type,
	title: fullTitle,
	pageTitle: pageTitle ?? (bare || siteTitle),
	description,
	canonical,
	image,
	content,
	seo: { ogImage: image, robots },
	siteName: siteTitle,
});

const cta = itemsOf(menus.header_cta)[0];
const columns = [
	{ heading: menuHeading(menus.footer_services, "Services"), items: itemsOf(menus.footer_services) },
	{ heading: menuHeading(menus.footer_hosting, "Hosting"), items: itemsOf(menus.footer_hosting) },
	{ heading: menuHeading(menus.footer_company, "Company"), items: itemsOf(menus.footer_company) },
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<script is:inline>document.documentElement.classList.add("js");</script>
		<Font cssVariable="--font-display" preload />
		<Font cssVariable="--font-body" preload />
		<link rel="icon" href={settings?.favicon?.url || "/favicon.png"} />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="alternate" type="application/rss+xml" title={`${siteTitle} blog`} href="/rss.xml" />
		<meta name="theme-color" content="#082A3A" />
		<title>{fullTitle}</title>
		<EmDashHead page={pageCtx} />
	</head>
	<body>
		<EmDashBodyStart page={pageCtx} />
		<div class="lfw">
			<a class="lfw-skip" href="#main">Skip to content</a>
			<Header siteTitle={siteTitle} logo={logo} items={itemsOf(menus.primary)} cta={cta} admin={!!Astro.locals.user} />
			<main id="main" class="lfw-page" tabindex="-1">
				<slot />
			</main>
			<Footer siteTitle={siteTitle} tagline={tagline} columns={columns} legal={itemsOf(menus.footer_legal)} contact={itemsOf(menus.footer_contact)} />
		</div>
		<EmDashBodyEnd page={pageCtx} />
	</body>
</html>
