---
import { getEmDashEntry, getSeoMeta, getSiteSettings } from "emdash";
import Base from "../layouts/Base.astro";
import Button from "../components/Button.astro";
import PageBlocks from "../components/PageBlocks.astro";
import PageIntro from "../components/PageIntro.astro";

// The home page is the page with the slug "home" (sample content creates it).
const { entry: page, cacheHint } = await getEmDashEntry("pages", "home");
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const settings = await getSiteSettings();
const siteTitle = settings?.title || "Lakefront Digital";
const seo = page
	? getSeoMeta(page, {
			siteTitle,
			siteUrl: Astro.url.origin,
			path: "/",
			defaultTitle: siteTitle,
			defaultDescription: page.data.summary || settings?.tagline || undefined,
		})
	: null;
---

{
	page && seo ? (
		<Base title={seo.title} pageTitle={seo.ogTitle} description={seo.description} canonical={seo.canonical} robots={seo.robots} content={{ collection: "pages", id: page.data.id, slug: "home" }}>
			<PageBlocks page={page} />
		</Base>
	) : (
		<Base title={siteTitle} description={settings?.tagline}>
			<PageIntro eyebrow="Getting started" title={siteTitle} lead="Create a page with the slug “home” and build it from Lakefront blocks, or rerun setup with the sample content." solo>
				<Button href="/_emdash/admin" iconRight="arrow-right">
					Open the admin
				</Button>
			</PageIntro>
		</Base>
	)
}
