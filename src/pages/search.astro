---
import { getEmDashCollection, getMenuWithCacheHint, search } from "emdash";
import Base from "../layouts/Base.astro";
import Badge from "../components/Badge.astro";
import Button from "../components/Button.astro";
import Eyebrow from "../components/Eyebrow.astro";
import Icon from "../components/Icon.astro";
import SearchForm from "../components/SearchForm.astro";
import { linkAttrs } from "../lib/menus";
import { truncate } from "../lib/text";
import { cachePage } from "../lib/cache";
import { loadPublishedSearchEntries, searchExcerpt, searchResultDestination, withPublishedContent, type SearchTextPart } from "../lib/search-results";

export const prerender = false;

// Full-text search over published pages and blog posts. Blocks aren't indexed,
// so each page's Summary and Search keywords carry what it should be found by.
const query = (Astro.url.searchParams.get("q") ?? "").trim().slice(0, 200);
const pathFor = (slug?: string | null) => (!slug || slug === "home" ? "/" : `/${slug}`);

let results: { collection: string; path: string; title: string; excerpt: SearchTextPart[] }[] = [];
let searchFailed = false;
if (query) {
	try {
		const { items } = await search(query, { collections: ["pages", "posts"], status: "published", limit: 30 });
		const candidates = items.flatMap((result) => searchResultDestination(result.collection, result.slug) ?? []);
		const published = await loadPublishedSearchEntries(candidates, async (collection, filter) => {
			const result = await getEmDashCollection(collection, filter);
			if (Astro.cache?.enabled) Astro.cache.set(result.cacheHint);
			return result;
		});
		const seen = new Set<string>();
		results = items.flatMap((result) => {
			const destination = searchResultDestination(result.collection, result.slug);
			const current = destination && published.get(destination.path);
			if (!destination || !current || seen.has(destination.path)) return [];
			seen.add(destination.path);
			return [{ collection: result.collection, path: destination.path, title: current.title, excerpt: searchExcerpt(current.title, result.snippet, current.description, query) }];
		});
	} catch (error) {
		console.error("[search]", error);
		searchFailed = true;
		Astro.response.status = 503;
	}
}

const [popularResult, ctaResult] = await Promise.all([getMenuWithCacheHint("search_popular"), getMenuWithCacheHint("header_cta")]);
const popular = popularResult.data?.items ?? [];
const ask = ctaResult.data?.items?.[0];

const ICONS: Record<string, string> = { home: "globe", services: "layout-template", hosting: "server", consultation: "clipboard-list", contact: "send", blog: "pen-line" };
const browse = query
	? []
	: (await withPublishedContent(() => getEmDashCollection("pages", { status: "published", limit: 50 }))).entries
			.map((entry) => ({
				href: pathFor(entry.id),
				title: entry.data.title,
				summary: entry.data.summary,
				icon: ICONS[entry.id] ?? (entry.data.template === "legal" ? "file-text" : "panels-top-left"),
			}))
			.sort((a, b) => (a.href === "/" ? -1 : b.href === "/" ? 1 : a.title.localeCompare(b.title)));

if (searchFailed) {
	Astro.response.headers.set("Cache-Control", "no-store");
	if (Astro.cache?.enabled) Astro.cache.set(false);
} else {
	// Collection tags also invalidate empty results after a new publication.
	if (Astro.cache?.enabled) Astro.cache.set({ tags: ["pages", "posts"] });
	await cachePage(Astro, { maxAge: 60 });
}
---

<Base title={query ? `Search: ${query}` : "Search"} description="Search the site." robots={query ? "noindex" : undefined}>
	<section class="lfw-search">
		<div class="lfw-container">
			<Eyebrow rule="leading">Search</Eyebrow>
			<h1 class="lfw-vh">Search the site</h1>
			<SearchForm query={query} autofocus={!query} />
			{
				!query && popular.length > 0 && (
					<div class="lfw-suggest">
						<span>Popular</span>
						{popular.map((item) => (
							<a class="lf-tag" {...linkAttrs(item)}>
								{item.label}
							</a>
						))}
					</div>
				)
			}
		</div>
	</section>

	<section class="lfw-section">
		<div class="lfw-container">
			{
				query && results.length > 0 && (
					<div class="lfw-results">
						<div class="lfw-results__bar">
							<p class="lfw-results__meta" role="status">
								{results.length} {results.length === 1 ? "result" : "results"} for <strong>“{query}”</strong>
							</p>
						</div>
						{results.map((result) => (
							<article class="lfw-result">
								<div class="lfw-result__path">
									<Badge>{result.collection === "posts" ? "Blog" : "Page"}</Badge>
									<span>{result.path}</span>
								</div>
								<h2 class="lfw-result__heading">
									<a class="lfw-result__title" href={result.path}>
										{result.title}
									</a>
								</h2>
								{result.excerpt.length > 0 && <p>{result.excerpt.map((part) => part.marked ? <mark>{part.text}</mark> : part.text)}</p>}
							</article>
						))}
					</div>
				)
			}
			{
				query && searchFailed && (
					<div class="lfw-empty lfw-empty--left" role="status">
						<h2 class="lfw-h3">Search is temporarily unavailable</h2>
						<p class="lfw-p">Please try again in a moment.</p>
					</div>
				)
			}
			{
				query && !searchFailed && results.length === 0 && (
					<div class="lfw-empty lfw-empty--left">
						<span class="lfw-tile lfw-tile--lg">
							<Icon name="search-x" size={28} />
						</span>
						<h2 class="lfw-h3">No results for “{query}”</h2>
						<p class="lfw-p">Check the spelling, or try a broader term.</p>
						{popular.length > 0 && (
							<div class="lfw-suggest">
								<span>Try</span>
								{popular.map((item) => (
									<a class="lf-tag" {...linkAttrs(item)}>
										{item.label}
									</a>
								))}
							</div>
						)}
						{ask && (
							<Button {...linkAttrs(ask)} variant="link" iconRight="arrow-right">
								Or ask us
							</Button>
						)}
					</div>
				)
			}
			{
				!query && browse.length > 0 && (
					<div class="lfw-browse">
						<h2 class="lfw-h4">Browse the site</h2>
						<div class="lfw-grid3">
							{browse.map((item) => (
								<a class="lf-card lf-card--pad-sm lf-card--interactive" href={item.href}>
									<div class="lf-card__body">
										<div class="lfw-browse__row">
											<span class="lfw-tile">
												<Icon name={item.icon} size={20} />
											</span>
											<div>
												<b>{item.title}</b>
												{item.summary && <span>{truncate(item.summary, 90)}</span>}
											</div>
										</div>
									</div>
								</a>
							))}
						</div>
					</div>
				)
			}
		</div>
	</section>
</Base>
