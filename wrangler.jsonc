{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "my-wordpress-site",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	// Keep variables set in the dashboard (e.g. EMDASH_SITE_URL) instead of deleting them on deploy
	"keep_vars": true,
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "my-dash-site","database_id": "f7811d82-9ef7-47de-924f-dec282789576",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "my-dash-media","preview_bucket_name": "my-dash-media",
		},
	],
	// Enquiry forms (Contact, Consultation) are emailed with Cloudflare Email Sending.
	// Onboard lakefrontdigital.io to Email Sending first. Don't enable Email Routing: it takes over the
	// domain's MX records, and the domain's mail is on Google Workspace.
	// ENQUIRY_FROM must be an address on that domain; ENQUIRY_TO must match destination_address.
	"send_email": [
		{
			"name": "ENQUIRY_EMAIL",
			"destination_address": "hello@lakefrontdigital.io",
		},
	],
	"vars": {
		"ENQUIRY_FROM": "website@lakefrontdigital.io",
		"ENQUIRY_TO": "hello@lakefrontdigital.io",
	},
	// Sandboxed plugins require Worker Loader, available on Workers paid plans.
	"worker_loaders": [{ "binding": "LOADER" }],
	// General maintenance cron trigger
	"triggers": {
		"crons": ["* * * * *"],
	},
}
