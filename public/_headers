# Bundled photos and brand files keep their names when they're replaced, so they're cached for a week, not forever.
# The build adds the immutable rule for /_astro/*, whose file names change with their content.
/images/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/brand/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
